{
  "name": "@tokensapi/dsh-plugin-check",
  "version": "0.4.0",
  "description": "TokensCowork/DSH 插件合格性体检:CLI 一条命令判定插件能否安全装入宿主;装入 Cowork 后提供会话内 plugin_check 工具。",
  "tokenscowork": {
    "displayName": {
      "zh-CN": "插件体检",
      "en-US": "Plugin Check"
    },
    "summary": {
      "zh-CN": "一条命令判定插件包能否安全装入宿主;装入 Cowork 后提供会话内 plugin_check 工具。",
      "en-US": "Decide in one command whether a plugin package is safe for the host to load, and expose a plugin_check tool inside the session once installed."
    }
  },
  "type": "module",
  "bin": {
    "dsh-plugin-check": "bin/dsh-plugin-check.mjs"
  },
  "files": [
    "bin",
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "semver": "^7.6.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.tokensapi.ai/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TokensAPI/tokens_DshPluginCheck_code.git"
  },
  "main": "lib/cowork-plugin.mjs",
  "exports": {
    ".": "./lib/cowork-plugin.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1 || 4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8 || 0.1.3-alpha.1"
  },
  "dsh": {
    "engine": ">=0.1.0-rc.8 <0.2.0",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
